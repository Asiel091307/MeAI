# Copia este archivo como .env y completa los valores.
# Docker Compose lee .env automáticamente; .env está en .gitignore. Nunca subas claves reales.

# Obligatoria: contraseña de PostgreSQL. compose.yaml no arranca sin ella.
# Solo se aplica la primera vez que se crea el volumen postgres_data.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Proveedor de IA: elige UNA de las opciones 1 a 4 (descomenta solo esa).
# Los embeddings y la generación se configuran por separado: puedes mezclarlos.
# Si cambias el modelo o las dimensiones de embeddings, reindexa los documentos.
# ---------------------------------------------------------------------------

# --- Opción 1: Gemini (predeterminada) ---
# Clave gratuita de Google AI Studio: https://aistudio.google.com/apikey
# Nivel gratuito: Google puede usar el contenido enviado; usa PDF no sensibles.
GEMINI_API_KEY=
# GEMINI_TIER=free
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash-lite

# --- Opción 2: OpenAI ---
# Clave de https://platform.openai.com/api-keys (de pago). Los PDF se envían a OpenAI.
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# GENERATION_PROVIDER=openai-compatible
# GENERATION_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- Opción 3: Ollama local (100 % privado, sin claves, sin enviar nada fuera) ---
# 1) Levanta Ollama:  docker compose --profile ollama up -d
# 2) Descarga los modelos (una sola vez):
#      docker compose exec ollama ollama pull nomic-embed-text
#      docker compose exec ollama ollama pull llama3.2:3b
# EMBEDDING_PROVIDER=openai-compatible
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# GENERATION_PROVIDER=openai-compatible
# GENERATION_MODEL=llama3.2:3b
# OPENAI_BASE_URL=http://ollama:11434/v1

# --- Opción 4: otro servicio compatible con OpenAI (OpenRouter, Groq, LM Studio...) ---
# Cada servicio tiene su URL base y su clave. Ejemplos de URL base:
#   OpenRouter: https://openrouter.ai/api/v1
#   Groq:       https://api.groq.com/openai/v1
#   LM Studio:  http://host.docker.internal:1234/v1
# Pon el nombre exacto del modelo según el catálogo del servicio.
# Ojo: Groq y OpenRouter no siempre ofrecen embeddings; puedes usar otro proveedor
# solo para embeddings con EMBEDDING_BASE_URL y EMBEDDING_API_KEY.
# GENERATION_PROVIDER=openai-compatible
# GENERATION_MODEL=nombre-del-modelo
# GENERATION_BASE_URL=https://openrouter.ai/api/v1
# GENERATION_API_KEY=
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Opción 5: tu propio PostgreSQL 15+ con la extensión pgvector
# ---------------------------------------------------------------------------
# Si defines DATABASE_URL, la app usa esa base (y aplica las migraciones al arrancar)
# en lugar del PostgreSQL que crea Docker Compose. La extensión `vector` debe estar disponible.
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos

# ---------------------------------------------------------------------------
# Parámetros experimentales del RAG. Vacíos o comentados = valores predeterminados.
# ---------------------------------------------------------------------------
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_TOP_K=5
