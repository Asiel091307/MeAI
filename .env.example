# Copia este archivo como .env y completa los valores.
# Docker Compose lee .env automáticamente; .env está en .gitignore.

# Obligatoria: contraseña de PostgreSQL. compose.yaml no arranca sin ella.
# Solo se aplica la primera vez que se crea el volumen postgres_data.
POSTGRES_PASSWORD=

# Referencia: compose.yaml ya define estas variables para el servicio app.
# No hace falta cambiarlas; DB_PASSWORD toma el valor de POSTGRES_PASSWORD.
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=meai
# DB_USER=meai
# DB_PASSWORD=${POSTGRES_PASSWORD}

# Proveedores de IA: se añadirán cuando una spec apruebe el proveedor.

