# Copia este archivo como .env y completa los valores.
# Docker Compose lee .env automáticamente; .env está en .gitignore.

# Obligatoria: contraseña de PostgreSQL. compose.yaml no arranca sin ella.
# Solo se aplica la primera vez que se crea el volumen postgres_data.
POSTGRES_PASSWORD=

# Referencia: compose.yaml ya define estas variables para el servicio app.
# No hace falta cambiarlas; DB_PASSWORD toma el valor de POSTGRES_PASSWORD.
# DB_HOST=db
# DB_PORT=5432
# DB_NAME=meai
# DB_USER=meai
# DB_PASSWORD=${POSTGRES_PASSWORD}

# Proveedores de IA (aprobados en docs/specs/002-proveedores-ia/spec.md).
# Clave de Google AI Studio. Nunca la subas al repositorio.
# Nivel gratuito: Google puede usar el contenido enviado; usa PDF no sensibles.
GEMINI_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
GENERATION_PROVIDER=gemini
GENERATION_MODEL=gemini-3.5-flash-lite

# Parámetros experimentales del RAG (T25). Vacíos = valores predeterminados.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# RETRIEVAL_TOP_K=5

